<li><a href=3D"#Lestests(niveau*interface*angle*type)-Rep=C3=A8respratiques=
d=E2=80=99utilisation">Rep=C3=A8res pratiques d=E2=80=99utilisation</a>
<ul class=3D"toc-indentation">
<li><a href=3D"#Lestests(niveau*interface*angle*type)-Quandchoisirsmall">Qu=
