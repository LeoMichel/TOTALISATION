s=C3=A0=C3=A9viter">Erreurs fr=C3=A9quentes =C3=A0 =C3=A9viter</a></li>
<li><a href=3D"#Lestests(niveau*interface*angle*type)-R=C3=A9sum=C3=A9op=C3=
=A9rationnel">R=C3=A9sum=C3=A9 op=C3=A9rationnel</a>
<ul class=3D"toc-indentation">
<li><a href=3D"#Lestests(niveau*interface*angle*type)-=F0=9F=93=9AR=C3=A9f=
=C3=A9rences">=F0=9F=93=9A R=C3=A9f=C3=A9rences</a></li>
