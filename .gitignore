# Fichiers de sauvegarde et backups
*.bak
*.backup
*~
*.swp

# Scripts de travail (à déplacer éventuellement dans automata/)
*.py
*.ps1

# Dossiers temporaires (le ! du nom est échappé : \! sinon ce serait une exception gitignore)
\!TEMPO/backup/
\!TEMPO/tools/
\!TEMPO/ideas/
\!TEMPO/images/
\!TEMPO/txt/
\!TEMPO/preview/

# Fichiers vides (pages de guidage non remplies)
*.md.empty

# Fichiers de configuration local
.local.*
